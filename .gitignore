# Large training datasets and downloaded archives (see train_ember_classifier.py /
# train_malware_classifier.py -- these are regenerated by running those scripts,
# not something to version-control)
data/ember2018/
data/bodmas/
data/scan_cache.json
data/scan_cache.json.bak
*.tar.bz2

# Synthetic training data regenerated by generate_sample_data.py (~29,600
# small JSON files -- committing these overwhelmed GitHub's directory
# listing, which truncates at 1,000 entries per directory)
data/labeled/

# Trained model artifacts (regenerable via the train_*.py scripts; some of these
# are 10s of MB each and add up fast). Note the ** so this also catches the
# nested models/<category>/<file>.pkl layout, not just top-level files.
models/**/*.pkl
models/*.pkl
models/*.txt
models/*.onnx
models/**/*.onnx

# Local GGUF language models (large, downloaded separately)
models/**/*.gguf
models/*.gguf
models/**/*.gguf.download
models/*.gguf.download

# Rust build artifacts (myproject/)
target/

# Runtime state/quarantine/scan artifacts -- generated at runtime, not source
quarantine/
failed_quarantine/
encrypted/
instance/
blocked_ips.json
_ransom_debug.log
antivirus.db

# Keep important files/folders (add ! in front)
!uploads/README.md
!logs/README.md

# Binary executables (generated by PyInstaller)
antivirus_server.exe

# Python installer (embedded into launcher, not committed)
python-3.11.9-amd64.exe

# --- Cloud / network deployment infrastructure ---
# The cloud server runs on a separate VPS; its deployment configs, certs,
# tunnel configs, and publish scripts are not part of the desktop app source
# and shouldn't be published to GitHub.

# Cloud server entry points / build specs (deployed separately on the VPS)
cloud_service.py
cloud_server.spec
wsgi.py
cloud_log.txt

# Cloudflare tunnel configs (may contain real tunnel IDs / hostnames)
cloudflared*.yml
cloudflared*.yaml
native/AntivirusServerLogin/cloudflared*.yml
native/AntivirusServerLogin/cloudflared*.yaml
cloudflared.exe
cloudflared.msi
cloudflared/

# Cloud deployment configs (nginx, systemd, deploy.sh for the VPS)
deploy/

# Cloud publish / release scripts (Azure/S3 blobs, store uploads)
publish_azure_blob.ps1
publish_s3.ps1

# Cloud restart / debug helper scripts
tools/restart_cloud.bat
tools/start_cloud_debug.bat

# Redis (used by the cloud server; not part of the desktop app)
setup_redis.py
dump.rdb

